# Copy to .env at repository root; never commit .env or real API keys.
# Literal KEY=value only. OS environment overrides this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 1: cached specialist models only; 0: allow remote downloads.
HF_HUB_OFFLINE=1

# Leave empty to use bundled primary weights and default architecture.
MEDICAL223_REPO_DIR=
MEDICAL223_MODEL_PATH=
MEDICAL223_MODEL_ARCH=tf_efficientnetv2_s.in21k_ft_in1k
MEDICAL223_IMAGE_SIZE=512
HF_TB_REPO=sukhmani1303/tuberculosis-vit-model
HF_PNEUMONIA_REPO=radiovision/Pneumonia-Detection

# Alternative compatible service: remove DEEPSEEK settings before using.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
